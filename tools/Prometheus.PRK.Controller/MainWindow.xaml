<Window x:Class="Prometheus.PRK.Controller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prometheus PRK Controller" Width="1100" Height="760" Background="#03101C" Foreground="#EAF6FF" WindowStartupLocation="CenterScreen"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="P R O M E T H E U S   P R K" FontSize="30" FontWeight="Bold" Foreground="#54BFFF"/><Border x:Name="StatusBorder" Grid.Row="1" BorderThickness="2" CornerRadius="8" Padding="12" Margin="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="DetailText" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="FileText" Grid.Column="1" FontSize="15" VerticalAlignment="Center"/></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel x:Name="HealthPanel"/><StackPanel Grid.Column="1" Margin="16,0,0,0"><Button Content="Refresh Health" Height="48" Margin="0,0,0,10" Click="Refresh_Click"/><Button Content="Run Self-Repair" Height="48" Margin="0,0,0,10" Click="Repair_Click"/><Button Content="Verify Recovery Key" Height="48" Margin="0,0,0,10" Click="Verify_Click"/><TextBlock Text="Self-repair only uses verified PRK sources. Protected-key corruption is blocked rather than overwritten." TextWrapping="Wrap" Foreground="#AFC2D0" Margin="0,12"/></StackPanel></Grid><TextBlock Grid.Row="3" Text="Green = 100% Ready   Yellow = Checking / Repairable   Red = Failed / Blocked" Foreground="#AFC2D0" Margin="0,12,0,0"/></Grid></Window>