<Window x:Class="Prometheus.PRK.Controller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prometheus PRK Controller" Height="850" Width="1320" MinHeight="760" MinWidth="1160" Background="#03101C" Foreground="#EAF6FF" WindowStartupLocation="CenterScreen">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#0D2233"/><Setter Property="Foreground" Value="#EAF6FF"/><Setter Property="BorderBrush" Value="#245776"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="92"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="P R O M E T H E U S   P R K" FontSize="32" FontWeight="Bold" Foreground="#54BFFF"/><TextBlock Text="Recovery Key Controller — integrity, staging and host recovery" FontSize="16" Foreground="#C5D8E7"/></StackPanel><Border Grid.Column="1" BorderBrush="#2076A8" BorderThickness="1" CornerRadius="7" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prometheus Recovery Key" FontSize="17" FontWeight="Bold" Foreground="#57C7FF"/><TextBlock x:Name="DeviceText" Foreground="#C5D8E7"/><TextBlock x:Name="VerifiedText" Foreground="#8199AA" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="ReadyText" Grid.Column="1" Text="CHECKING" VerticalAlignment="Center" Foreground="#E4B72C" FontWeight="Bold"/></Grid></Border></Grid>
<Border x:Name="StatusBorder" Grid.Row="1" Margin="0,14" BorderBrush="#E4B72C" BorderThickness="2" CornerRadius="8" Padding="14" Background="#071A20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="STATUS: CHECKING" FontSize="22" FontWeight="Bold" Foreground="#E4B72C"/><TextBlock x:Name="DetailText" Text="Reading live Recovery Key health..." Foreground="#D4E2EC" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CURRENT STATE" Foreground="#8199AA"/><TextBlock x:Name="CurrentStateText" Text="CHECKING" FontSize="17" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="EJECT STATE" Foreground="#8199AA"/><TextBlock x:Name="EjectStateText" Text="MOUNTED / ACTIVE" FontSize="17" FontWeight="Bold" Foreground="#57C7FF"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="DriveText" Foreground="#C5D8E7"/><TextBlock Text="Role: Recovery / Bootstrap Key" Foreground="#C5D8E7"/><TextBlock x:Name="FileText" Foreground="#C5D8E7"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
<Border BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="13" Background="#061522"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,7"><TextBlock Text="Live Recovery Health" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="OverallText" Text="CHECKING" FontSize="18" FontWeight="Bold" Foreground="#E4B72C" HorizontalAlignment="Right"/></Grid><ProgressBar Grid.Row="1" x:Name="OverallBar" Height="11" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HealthPanel"/></ScrollViewer></Grid></Border>
<StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="Recovery Actions" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><Button x:Name="DiagnosticsButton" Content="Run Diagnostics" Height="44" Margin="0,0,0,7" Click="Diagnostics_Click"/><Button x:Name="VerifyButton" Content="Verify Recovery Key" Height="44" Margin="0,0,0,7" Click="Verify_Click"/><Button x:Name="StageButton" Content="Stage Recovery" Height="44" Margin="0,0,0,7" Click="Stage_Click"/><Button x:Name="BootstrapButton" Content="Bootstrap Windows Host" Height="44" Margin="0,0,0,7" Click="Bootstrap_Click"/><Button x:Name="RepairButton" Content="Run Self-Repair" Height="48" Margin="0,4,0,7" FontWeight="Bold" Click="Repair_Click"/><Button x:Name="LogsButton" Content="View Logs" Height="38" Margin="0,0,0,7" Click="Logs_Click"/><Button x:Name="RefreshButton" Content="Refresh Health" Height="38" Click="Refresh_Click"/></StackPanel>
<Border Grid.Column="2" BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="14" Background="#061522"><StackPanel><TextBlock Text="Recovery &amp; Self-Repair" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock x:Name="SummaryText" Text="Reading live recovery channels..." TextWrapping="Wrap" Foreground="#C5D8E7"/><TextBlock Text="Protected-key corruption is never overwritten from the same source. Unsafe repairs are blocked." TextWrapping="Wrap" Foreground="#AFC2D0" Margin="0,18,0,0"/></StackPanel></Border></Grid>
<Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="12" Background="#061522"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Live Log (latest)" FontSize="17" FontWeight="Bold"/><TextBox x:Name="LogText" Grid.Row="1" Margin="0,7,0,0" Background="Transparent" BorderThickness="0" Foreground="#BFD6E5" IsReadOnly="True" Text="Controller started." TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border><Border Grid.Column="1" Margin="14,0,0,0" BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="12" Background="#061522"><StackPanel><TextBlock Text="Safety Contract" FontSize="17" FontWeight="Bold"/><TextBlock Text="Verify source → diagnose → bounded repair → re-verify → report. Eject stages to C: before PRK-backed processes are closed." TextWrapping="Wrap" Foreground="#BFD6E5" Margin="0,7,0,0"/></StackPanel></Border></Grid>
<Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="270"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Green = Healthy / Complete     Yellow = Working / Repairable     Red = Failed / Blocked" Foreground="#AFC2D0" VerticalAlignment="Center"/><Button x:Name="EjectButton" Grid.Column="1" Content="Prepare Key for Eject" Height="42" Margin="12,0" FontWeight="Bold" BorderBrush="#E4B72C" Foreground="#E4B72C" Click="Eject_Click"/><TextBlock Grid.Column="2" Text="Build v0.5.2-dev" Foreground="#B7C9D8" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
</Grid></Window>