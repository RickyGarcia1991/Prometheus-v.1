<Window x:Class="Prometheus.DriveController.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prometheus Drive Controller" Height="650" Width="980" MinHeight="560" MinWidth="820" Background="#07111D" Foreground="#EAF6FF" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="P R O M E T H E U S" FontSize="30" FontWeight="SemiBold" Foreground="#57C7FF"/><TextBlock Text="Drive Controller v0.5.0 — measurable lifecycle" FontSize="16" Foreground="#B7C9D8" Margin="0,4,0,18"/></StackPanel>
<Border Grid.Row="1" BorderBrush="#19C37D" BorderThickness="1.5" CornerRadius="8" Padding="16" Background="#0B1B24"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StateText" Text="DRIVE DETECTED — READY" FontSize="20" FontWeight="Bold" Foreground="#40E08B"/><TextBlock x:Name="ActivityText" Text="Prometheus SSD detected. Ready to start." Margin="0,7,0,0" Foreground="#C8D7E3"/></StackPanel><TextBlock Grid.Column="1" x:Name="PercentText" Text="0%" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Foreground="#57C7FF"/></Grid></Border>
<Grid Grid.Row="2" Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="#244357" BorderThickness="1" CornerRadius="8" Padding="18" Background="#091722"><StackPanel><TextBlock Text="Measured Progress" FontSize="18" FontWeight="SemiBold"/><ProgressBar x:Name="OverallProgress" Height="18" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,16"/><ItemsControl x:Name="StepsList"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="18,0,0,0"><Button x:Name="StartButton" Content="▶  Start Prometheus" Height="54" Margin="0,0,0,10" Click="Start_Click"/><Button x:Name="StopButton" Content="■  Stop Prometheus" Height="54" Margin="0,0,0,10" IsEnabled="False" Click="Stop_Click"/><Button Content="Open Chat" Height="46" Margin="0,0,0,10"/><Button Content="Knowledge Vault" Height="46" Margin="0,0,0,10"/><Button Content="View Logs" Height="46"/></StackPanel></Grid>
<Border Grid.Row="3" Background="#0B1B24" CornerRadius="6" Padding="12"><TextBlock Text="Green is verification-backed. Unknown SSD processes or failed checks block eject readiness." Foreground="#AFC2D0"/></Border></Grid></Window>