<Window x:Class="Prometheus.DriveController.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prometheus Drive Controller" Height="820" Width="1280" MinHeight="720" MinWidth="1080" Background="#03101C" Foreground="#EAF6FF" WindowStartupLocation="CenterScreen">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#0D2233"/><Setter Property="Foreground" Value="#EAF6FF"/><Setter Property="BorderBrush" Value="#245776"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="P R O M E T H E U S" FontSize="32" FontWeight="Bold" Foreground="#54BFFF"/><TextBlock Text="Drive Controller v0.5.10 — measured status / safe eject" FontSize="16" Foreground="#C5D8E7"/></StackPanel><Border Grid.Column="1" BorderBrush="#2076A8" BorderThickness="1" CornerRadius="7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prometheus SSD" FontSize="17" FontWeight="Bold" Foreground="#57C7FF"/><TextBlock x:Name="DriveInfoText" Text="Detecting..." Foreground="#C5D8E7"/></StackPanel><TextBlock Grid.Column="1" x:Name="DriveStateText" Text="Checking" VerticalAlignment="Center" Foreground="#E4B72C" FontWeight="Bold"/></Grid></Border></Grid>
<Border x:Name="StatusBorder" Grid.Row="1" Margin="0,14,0,14" BorderBrush="#E4B72C" BorderThickness="2" CornerRadius="8" Padding="15" Background="#071A20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StateText" Text="STATUS: CHECKING" FontSize="22" FontWeight="Bold" Foreground="#E4B72C"/><TextBlock x:Name="ActivityText" Text="Reading controller state..." Foreground="#D4E2EC" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CURRENT OPERATION" Foreground="#8199AA"/><TextBlock x:Name="OperationText" Text="Checking" FontSize="18" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="WINDOWS RELEASED" Foreground="#8199AA"/><TextBlock x:Name="EjectText" Text="No" FontSize="18" FontWeight="Bold" Foreground="#E4B72C"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="DeviceText" Text="SSD: Detecting" Foreground="#C5D8E7"/><TextBlock Text="Prometheus portable drive" Foreground="#C5D8E7"/><TextBlock Text="Hardware health: see disk diagnostics" Foreground="#C5D8E7"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
<Border BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="15" Background="#061522"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Measured Progress" FontSize="20" FontWeight="Bold"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="Overall Progress" Foreground="#AFC2D0"/><TextBlock x:Name="PercentText" Text="Ready" FontSize="18" FontWeight="Bold" Foreground="#57C7FF" HorizontalAlignment="Right"/></StackPanel></Grid><ProgressBar x:Name="OverallProgress" Grid.Row="1" Height="12" Minimum="0" Maximum="100" Margin="0,12,0,12"/><ItemsControl x:Name="StepsList" Grid.Row="2">
<ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding Icon}" Foreground="{Binding Color}" VerticalAlignment="Center"/>
<TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}"/>
<TextBlock Grid.Column="2" Text="{Binding WeightText}" TextAlignment="Right" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Contribution to overall operation progress; green means this check passed."/>
<TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{Binding Color}" VerticalAlignment="Center"/>
<ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0" Minimum="0" Maximum="100" Value="{Binding Value}" Foreground="{Binding Color}" Background="#23384A" BorderThickness="0" ToolTip="{Binding Detail}"/>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="ElapsedText" Text="Waiting for an operation." FontWeight="SemiBold" Foreground="#BFD6E5"/><TextBlock x:Name="RepairText" Text="WATCHDOG: ARMED / IDLE" Margin="0,4,0,0" FontFamily="Consolas" Foreground="#8199AA"/></StackPanel></Grid></Border>
<ScrollViewer Grid.Column="1" Margin="14,0" VerticalScrollBarVisibility="Auto"><StackPanel><Button x:Name="StartButton" Content="▶  Start Prometheus" Height="58" Margin="0,0,0,10" Click="Start_Click"/><Button x:Name="StopButton" Content="■  Stop Prometheus" Height="58" Margin="0,0,0,10" IsEnabled="False" Click="Stop_Click"/><Button x:Name="EjectButton" Content="Eject &amp; verify" Height="48" Margin="0,0,0,10" Click="Eject_Click"/><Button Content="Open Chat" Height="48" Margin="0,0,0,10" Click="OpenChat_Click"/><Button Content="Knowledge Vault" Click="Knowledge_Click" Height="48" Margin="0,0,0,10"/><Button Content="View Logs" Click="Logs_Click" Height="48" Margin="0,0,0,10"/><Button Content="Settings" Click="Settings_Click" Height="48"/></StackPanel></ScrollViewer>
<Border Grid.Column="2" BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="14" Background="#061522"><StackPanel><TextBlock Text="System Components" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock x:Name="SsdComponent" Text="● SSD Detection — Checking" Margin="0,7"/><TextBlock x:Name="RuntimeComponent" Text="● Runtime (Python) — Checking" Margin="0,7"/><TextBlock x:Name="OllamaComponent" Text="● Ollama Service — Stopped" Margin="0,7"/><TextBlock x:Name="ModelComponent" Text="● Model Load — Stopped" Margin="0,7"/><TextBlock x:Name="MemoryComponent" Text="● Memory DB — Checking" Margin="0,7"/><TextBlock x:Name="StoreComponent" Text="● Model Store — Checking" Margin="0,7"/><TextBlock x:Name="SourceComponent" Text="● Source Tree — Checking" Margin="0,7"/><TextBlock x:Name="ChatComponent" Text="● Chat Runtime — Stopped" Margin="0,7"/></StackPanel></Border></Grid>
<Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="12" Background="#061522"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Live Log (latest)" FontSize="17" FontWeight="Bold"/><TextBox x:Name="LogText" Grid.Row="1" Margin="0,7,0,0" Background="Transparent" BorderThickness="0" Foreground="#BFD6E5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border><Border Grid.Column="1" Margin="14,0,0,0" BorderBrush="#197CB7" BorderThickness="1" CornerRadius="8" Padding="12" Background="#061522"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Last Startup" FontWeight="Bold"/><TextBlock x:Name="StartupTimeText" Text="—" Foreground="#BFD6E5"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Last Shutdown" FontWeight="Bold"/><TextBlock x:Name="ShutdownTimeText" Text="—" Foreground="#BFD6E5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Last Verification" FontWeight="Bold"/><TextBlock x:Name="VerifyTimeText" Text="—" Foreground="#BFD6E5"/></StackPanel></Grid></Border></Grid>
<Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="● Green = Verified / Ready     ● Yellow = Active / Checking     ● Red = Blocked / Error" Foreground="#AFC2D0"/><TextBlock Grid.Column="1" Text="Build v0.5.10  |  Created by Ricky Garcia" Foreground="#B7C9D8" FontWeight="SemiBold"/></Grid>
</Grid></Window>